// Cloudflare Workers, static assets only: no Worker script, Cloudflare serves dist/ as it is.
// Deployed by .github/workflows/deploy.yml (`pnpm run deploy` after `pnpm build`).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "langbg",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // /fonts/ serves fonts/index.html; /fonts redirects to /fonts/ (the site uses trailing slashes).
    "html_handling": "auto-trailing-slash",
    // An unknown address gets the nearest 404.html up its path: /en/... -> /en/404.html, else /404.html.
    "not_found_handling": "404-page"
  },
  // Custom domains: Cloudflare creates the DNS records and certificates on deploy.
  // www.langbg.com is redirected to langbg.com by a Redirect Rule (set in the dashboard),
  // which runs before the request reaches the assets.
  "routes": [
    { "pattern": "langbg.com", "custom_domain": true },
    { "pattern": "www.langbg.com", "custom_domain": true }
  ],
  // Only langbg.com: no copy of the site on *.workers.dev or on preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // No usage telemetry from wrangler.
  "send_metrics": false
}

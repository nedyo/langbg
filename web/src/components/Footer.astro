---
import Link from "./Link.astro";
import { localePath, ui, type Lang } from "../i18n";
import { SITE } from "../data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<footer class="site-footer ui">
  <div class="wrap site-footer-inner">
    <p>{t.footer.tagline} {t.footer.privacy}</p>
    <div class="footer-links">
      <a href={localePath(lang, "/about/")}>{t.nav.about}</a>
      <Link href={SITE.repo}>{t.footer.source}</Link>
      <span>{t.footer.license}</span>
    </div>
  </div>
</footer>

---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button class="theme-toggle" type="button" id="theme-toggle" aria-label={label} aria-pressed="false" title={label}>
  <span class="theme-icon" aria-hidden="true"></span>
</button>

<script>
  // Light unless the visitor picked dark here; the OS setting doesn't count.
  const button = document.getElementById("theme-toggle") as HTMLButtonElement | null;
  const root = document.documentElement;

  const isDark = (): boolean => root.dataset.theme === "dark";
  const sync = (): void => button?.setAttribute("aria-pressed", String(isDark()));

  button?.addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    if (next === "dark") root.dataset.theme = "dark";
    else delete root.dataset.theme;
    try {
      localStorage.setItem("theme", next);
    } catch {
      // Private mode or blocked storage: the choice just lasts until the page closes.
    }
    sync();
  });
  sync();
</script>
